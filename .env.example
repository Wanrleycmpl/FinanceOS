# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Só a chave PUBLICÁVEL (sb_publishable_...). Nunca coloque service_role/secret aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só para npm run test:rls: dois usuários de teste temporários (ex.: teste-a@financeos.local), criados no painel.
RLS_TEST_USER_A_EMAIL=
RLS_TEST_USER_A_PASSWORD=
RLS_TEST_USER_B_EMAIL=
RLS_TEST_USER_B_PASSWORD=
